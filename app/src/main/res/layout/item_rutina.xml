<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stat_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <!-- Icono Fitness -->
    <ImageView
        android:id="@+id/imgBadgeIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_box"
        android:contentDescription="@string/app_name"
        android:padding="9dp"
        android:src="@drawable/ic_fitness"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nombre de la Rutina -->
    <TextView
        android:id="@+id/tvNombreRutina"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        app:layout_constraintEnd_toStartOf="@id/tvStatusBadge"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Rutina Hipertrofia A" />

    <!-- Nombre del Cliente -->
    <TextView
        android:id="@+id/tvNombreCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/red_accent"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvStatusBadge"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toBottomOf="@id/tvNombreRutina"
        tools:text="Kira Sash Carrasco" />

    <!-- Objetivo -->
    <TextView
        android:id="@+id/tvObjetivo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/imgChevron"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toBottomOf="@id/tvNombreCliente"
        tools:text="Objetivo: Aumento de masa muscular" />

    <!-- Nivel y Fecha -->
    <TextView
        android:id="@+id/tvNivelFecha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/imgChevron"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toBottomOf="@id/tvObjetivo"
        tools:text="Nivel: Intermedio • Inicio: 04/09/2026" />

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_active"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/badge_green"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/imgChevron"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="● ACTIVA" />

    <!-- Chevron -->
    <ImageView
        android:id="@+id/imgChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
