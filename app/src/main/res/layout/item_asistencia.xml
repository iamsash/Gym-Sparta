<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stat_card"
    android:padding="16dp">

    <!-- Icono Check / Asistencia -->
    <ImageView
        android:id="@+id/imgBadgeIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_box"
        android:contentDescription="@string/app_name"
        android:padding="9dp"
        android:src="@drawable/ic_check_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nombre del Cliente -->
    <TextView
        android:id="@+id/tvNombreCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/tvTurnoBadge"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Kira Sash Carrasco" />

    <!-- Fecha y Hora de Ingreso -->
    <TextView
        android:id="@+id/tvFechaHora"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tvTurnoBadge"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toBottomOf="@id/tvNombreCliente"
        tools:text="04/09/2026 • 13:48 hs" />

    <!-- Observación / Nota si existe -->
    <TextView
        android:id="@+id/tvObservacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/tvTurnoBadge"
        app:layout_constraintStart_toEndOf="@id/imgBadgeIcon"
        app:layout_constraintTop_toBottomOf="@id/tvFechaHora"
        tools:text="Entrenamiento personalizado" />

    <!-- Turno Badge (MAÑANA / TARDE / NOCHE) -->
    <TextView
        android:id="@+id/tvTurnoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_green"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/badge_green"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="TARDE ✓" />

</androidx.constraintlayout.widget.ConstraintLayout>
